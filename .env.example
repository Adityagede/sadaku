# Konfigurasi MySQL lokal. Sesuaikan dengan server database milikmu.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sadaku
DB_USERNAME=root
DB_PASSWORD=""

# Produksi Vercel: isi melalui Environment Variables, bukan file di Git.
APP_ENV=local
APP_KEY=""
APP_USER=""
APP_PASSWORD_HASH=""
# Tautan publik opsional untuk Pengaturan. Hanya HTTPS; kosong = Belum tersedia.
# Isi APP_RATE_URL setelah halaman aplikasi di Google Play tersedia.
APP_RATE_URL=""
APP_SUPPORT_URL=""
# Produksi otomatis memakai TLS; lokal tidak, kecuali DB_SSL=true.
DB_SSL=false
# Opsional: CA database khusus, format PEM dengan newline sebagai \n.
DB_SSL_CA_PEM=""

# Web Push. Buat kunci sekali dengan php scripts/setup-push.php.
# Gunakan alamat HTTPS situs produksi atau mailto:alamat-kontak sebagai subject.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
