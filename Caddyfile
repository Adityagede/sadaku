{
    auto_https off
    admin off
}

:{$PORT:80} {
    root * /app/public
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        Content-Security-Policy "default-src 'self'; img-src 'self' blob:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        Cache-Control "private, no-store"
        -Server
    }
    @private_api path /php/*
    basic_auth @private_api {
        {$APP_USER} {$APP_PASSWORD_HASH}
    }
    php_server
}
