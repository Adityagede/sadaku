DirectoryIndex index.html
Options -Indexes
RewriteEngine On
RewriteRule ^(?:database|storage|scripts|tests|deployment|node_modules|vendor|\.npm-cache|\.git|\.test-mysql-[^/]*|\.test-storage-[^/]*)(?:/|$) - [F,L,NC]
RewriteRule ^php/(?!api\.php$) - [F,L,NC]
<FilesMatch "^(?:\..*|package.*\.json|composer\.(?:json|lock)|.*\.md|Dockerfile|Caddyfile)$">
    Require all denied
</FilesMatch>
