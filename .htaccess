DirectoryIndex index.html
Options -Indexes
RewriteEngine On
RewriteRule ^(?:database|storage|scripts|node_modules|\.npm-cache|\.git|\.test-mysql-[^/]*)(?:/|$) - [F,L,NC]
RewriteRule ^php/(?!api\.php$) - [F,L,NC]
<FilesMatch "^(?:\..*|package.*\.json|SOP\.md|README\.md)$">
    Require all denied
</FilesMatch>
