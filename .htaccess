DirectoryIndex index.html
Options -Indexes
RewriteEngine On
RewriteRule ^(?:database|storage|scripts|deployment|node_modules|vendor|\.npm-cache|\.git|\.test-mysql-[^/]*)(?:/|$) - [F,L,NC]
RewriteRule ^php/(?!api\.php$) - [F,L,NC]
<FilesMatch "^(?:\..*|package.*\.json|composer\.(?:json|lock)|SOP\.md|README\.md|DEPLOYMENT\.md|Dockerfile|Caddyfile)$">
    Require all denied
</FilesMatch>
